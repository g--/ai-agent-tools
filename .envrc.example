# Copy this file to .envrc, select one backend and its native model IDs, then
# run `direnv allow`. Separate evaluation models with commas. CONTROL_MODEL and
# JUDGE_MODEL default to the first evaluation model; --provider overrides all.
export EVAL_PROVIDER=copilot
export EVAL_MODELS=gpt-5.6-luna
# export EVAL_MODELS=gpt-5.6-luna,gpt-6-astra
# export CONTROL_MODEL=gpt-5.6-luna
# export JUDGE_MODEL=gpt-5.6-luna

# GitHub Copilot CLI: run `gh copilot` once to install and authenticate.

# OpenRouter example:
# export EVAL_PROVIDER=openrouter
# export EVAL_MODELS=openai/gpt-5.6-luna,openai/gpt-5.4-mini
# export CONTROL_MODEL=openai/gpt-5.6-luna
# export JUDGE_MODEL=openai/gpt-5.6-luna
# export OPENROUTER_API_KEY=your-api-key

# AWS Bedrock example. Prefer an authenticated profile over long-lived keys:
# export EVAL_PROVIDER=bedrock
# export EVAL_MODELS=us.anthropic.claude-haiku-4-5-20251001-v1:0
# export CONTROL_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# export JUDGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# export AWS_PROFILE=your-profile

# OpenAI example:
# export EVAL_PROVIDER=openai
# export EVAL_MODELS=gpt-4o-mini
# export CONTROL_MODEL=gpt-4o-mini
# export JUDGE_MODEL=gpt-4o-mini
# export OPENAI_API_KEY=your-api-key
